{
  "name": "soco-ukraine",
  "version": "1.0.0",
  "private": true,
  "description": "SOCO Ukraine — премиальный интернет-магазин стоматологических материалов и оборудования",
  "type": "module",
  "scripts": {
    "build:html": "node build.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "build": "npm run build:html && npm run build:css",
    "build:themes": "node build.mjs --themes",
    "build:theme-one": "node build.mjs --theme=premium-black",
    "build:theme-two": "node build.mjs --theme=dental-future",
    "build:all": "npm run build && npm run build:themes",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "dev": "node build.mjs --watch",
    "serve": "node server.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
